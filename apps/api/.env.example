NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_APP_URL=http://localhost:3000

# Supabase server values. The publishable key does not bypass RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Cloudflare R2 (server only). Never prefix these names with NEXT_PUBLIC_.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=nexora-private
