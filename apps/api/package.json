{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @nexora/contracts build && node --env-file=.env --watch --import tsx src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "pnpm --filter @nexora/contracts build && LOG_LEVEL=silent vitest run",
    "typecheck": "pnpm --filter @nexora/contracts build && tsc --noEmit"
  },
  "dependencies": {
    "@nexora/contracts": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
